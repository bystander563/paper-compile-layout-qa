{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bystander563/paper-compile-layout-qa/venue-profile.schema.json",
  "title": "Conference venue profile",
  "type": "object",
  "required": [
    "profile_version",
    "venue",
    "year",
    "track",
    "mode",
    "verified_at",
    "official_sources",
    "template",
    "page_policy",
    "pdf",
    "mode_rules",
    "content_rules",
    "venue_checker"
  ],
  "properties": {
    "profile_version": {"const": 1},
    "venue": {"type": "string", "minLength": 1},
    "year": {"type": "integer", "minimum": 2000},
    "track": {"type": "string", "minLength": 1},
    "mode": {"enum": ["review", "rebuttal", "final", "preprint"]},
    "verified_at": {"type": "string", "format": "date"},
    "official_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "url", "accessed", "supports"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https://"},
          "accessed": {"type": "string", "format": "date"},
          "supports": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "template": {
      "type": "object",
      "required": ["family", "files", "required_tex_patterns", "forbidden_tex_patterns"],
      "properties": {
        "family": {"type": "string", "minLength": 1},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "required", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "required": {"type": "boolean"},
              "sha256": {"type": "string", "pattern": "^$|^[0-9a-fA-F]{64}$"}
            }
          }
        },
        "required_tex_patterns": {"type": "array", "items": {"type": "string"}},
        "forbidden_tex_patterns": {"type": "array", "items": {"type": "string"}}
      }
    },
    "page_policy": {
      "type": "object",
      "required": ["main_page_limit", "references_count", "appendix_count", "total_pdf_limit", "notes"],
      "properties": {
        "main_page_limit": {"type": ["integer", "null"], "minimum": 1},
        "references_count": {"type": ["boolean", "null"]},
        "appendix_count": {"type": ["boolean", "null"]},
        "total_pdf_limit": {"type": ["integer", "null"], "minimum": 1},
        "notes": {"type": "string"}
      }
    },
    "pdf": {
      "type": "object",
      "required": ["paper_size", "columns", "fonts_must_be_embedded", "type3_fonts_allowed"],
      "properties": {
        "paper_size": {"enum": ["letter", "a4", "venue-controlled"]},
        "columns": {"type": ["integer", "null"], "enum": [1, 2, null]},
        "fonts_must_be_embedded": {"type": "boolean"},
        "type3_fonts_allowed": {"type": "boolean"}
      }
    },
    "mode_rules": {
      "type": "object",
      "required": ["anonymous", "pdf_author_metadata", "line_numbers", "page_numbers"],
      "properties": {
        "anonymous": {"type": "boolean"},
        "pdf_author_metadata": {"enum": ["empty", "allowed", "required"]},
        "line_numbers": {"enum": ["required", "forbidden", "optional", "venue-controlled"]},
        "page_numbers": {"enum": ["required", "forbidden", "optional", "venue-controlled"]}
      }
    },
    "content_rules": {
      "type": "object",
      "required": ["required_sections", "required_section_patterns", "manual_checks"],
      "properties": {
        "required_sections": {"type": "array", "items": {"type": "string"}},
        "required_section_patterns": {"type": "array", "items": {"type": "string"}},
        "manual_checks": {"type": "array", "items": {"type": "string"}}
      }
    },
    "layout_rules": {
      "type": "object",
      "required": [
        "body_bottoms",
        "final_page_columns",
        "manual_vertical_spacing",
        "forced_page_breaks",
        "blank_bands",
        "column_bottom_tolerance_pt",
        "blank_band_min_pt",
        "log_required",
        "ignore_pages"
      ],
      "properties": {
        "body_bottoms": {"enum": ["template-controlled", "flush", "ragged"]},
        "final_page_columns": {"enum": ["template-controlled", "balanced", "natural"]},
        "manual_vertical_spacing": {"enum": ["review", "forbid", "allow"]},
        "forced_page_breaks": {"enum": ["review", "forbid", "allow"]},
        "blank_bands": {"enum": ["review", "forbid", "allow"]},
        "column_bottom_tolerance_pt": {"type": "number", "exclusiveMinimum": 0},
        "blank_band_min_pt": {"type": "number", "exclusiveMinimum": 0},
        "log_required": {"type": "boolean"},
        "ignore_pages": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1},
          "uniqueItems": true
        },
        "notes": {"type": "string"}
      }
    },
    "venue_checker": {
      "type": "object",
      "required": ["command", "required", "result", "evidence"],
      "properties": {
        "command": {"type": "string"},
        "required": {"type": "boolean"},
        "result": {"enum": ["NOT_RUN", "PASS", "FAIL"]},
        "evidence": {"type": "string"}
      }
    }
  },
  "additionalProperties": true
}
